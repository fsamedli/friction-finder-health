# Copy this file to .env (same folder) and fill in the GW-provided key.
# .env is git-ignored and never leaves this laptop. Never paste the key into code or notebooks.
# The instructor's variable name:
GW_AZURE_OPENAI_KEY=paste-the-gw-key-here
# The group's assigned Azure OpenAI resource (gw-sb-04). Use only this one.
AZURE_OPENAI_ENDPOINT=https://gw-sb-04.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
# Azure *deployment* names available on the resource. Run `python -m app.probe` to discover them.
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
